import { initializeApp } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";
import { getFirestore, collection, query, orderBy, onSnapshot, doc, getDoc, setDoc } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";
import { firebaseConfig } from "./firebase-config.js";

const app=initializeApp(firebaseConfig),auth=getAuth(app),db=getFirestore(app);
const $=id=>document.getElementById(id);
function isHttpUrl(v){
  try{const u=new URL(String(v||"").trim());return u.protocol==="https:"}catch{return false}
}
function toast(m){$("toast").textContent=m;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),2500)}
async function isAdmin(uid){
  const s=await getDoc(doc(db,"users",uid));
  if(!s.exists()) return false;
  const role=String(s.data().role||"").trim().toLowerCase();
  return role==="admin";
}

onAuthStateChanged(auth,async u=>{
 if(!u){$("dashboard").hidden=true;$("adminLoginCard").hidden=false;return}
 try {
   const adminOk=await isAdmin(u.uid);
   if(!adminOk){toast("Not authorized as admin. Firestore users document/role not found.");await signOut(auth);return}
 } catch(x) { toast("Admin check failed: "+(x?.message||x)); await signOut(auth); return }
 $("adminLoginCard").hidden=true;$("dashboard").hidden=false;load();
});
$("adminLoginForm").onsubmit=async e=>{e.preventDefault();try{await signInWithEmailAndPassword(auth,$("adminEmail").value,$("adminPassword").value)}catch(x){toast(x.message)}};
$("adminLogout").onclick=()=>signOut(auth);

async function load(){
 const set=await getDoc(doc(db,"adminSettings","public"));const d=set.data()||{};$("logoUrl").value=d.logoUrl||"";$("splashUrl").value=d.splashUrl||"";$("qrUrl").value=d.qrUrl||"";
 $("settingsForm").onsubmit=async e=>{e.preventDefault();try{
  const logo=$("logoUrl").value.trim(), splash=$("splashUrl").value.trim(), qr=$("qrUrl").value.trim();
  for(const [label,url] of [["Logo",logo],["Splash",splash],["Payment QR",qr]]) if(url && !isHttpUrl(url)) throw new Error(`${label} must be a valid http/https URL.`);
  await setDoc(doc(db,"adminSettings","public"),{logoUrl:logo,splashUrl:splash,qrUrl:qr,updatedAt:new Date(),updatedBy:auth.currentUser.uid});
  toast("Settings saved.");
}catch(x){toast(x.message)}};
 $("tFree").onchange=()=>{$("tFee").disabled=$("tFree").value==="true";if($("tFee").disabled)$("tFee").value=0};
 $("tournamentForm").onsubmit=createTournament;
 $("roomForm").onsubmit=roomUpdate;
 loadDeposits();loadTournaments();loadPlayers();
}
async function api(path,body){const token=await auth.currentUser.getIdToken();const r=await fetch(path,{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+token},body:JSON.stringify(body)});const x=await r.json();if(!x.success)throw new Error(x.message);return x}
async function createTournament(e){e.preventDefault();try{
  const imageUrl=$("tImage").value.trim(); if(!isHttpUrl(imageUrl)) throw new Error("Tournament image must be a valid http/https URL.");
  let prizes={};if($("tPrizes").value.trim())prizes=JSON.parse($("tPrizes").value);
  const x=await api("/api/createTournament",{name:$("tName").value,imageUrl,mode:$("tMode").value,isFree:$("tFree").value==="true",entryFee:Number($("tFee").value||0),totalSlots:Number($("tSlots").value),perKill:Number($("tKill").value||0),registrationEnd:$("tReg").value,matchDateTime:$("tDate").value,prizes});
  toast("Created: "+x.tournamentId);e.target.reset()
}catch(x){toast(x.message)}}
async function roomUpdate(e){e.preventDefault();try{await api("/api/updateRoomCredentials",{tournamentId:$("roomTournamentId").value,roomId:$("roomId").value,roomPassword:$("roomPassword").value});toast("Room credentials updated.")}catch(x){toast(x.message)}}
function loadDeposits(){onSnapshot(query(collection(db,"depositRequests"),orderBy("createdAt","desc")),s=>{$("deposits").innerHTML=s.docs.map(d=>{const x=d.data();return `<div class="listrow"><b>${esc(x.amount)} · ${esc(x.utr)}</b> — ${esc(x.status)}<br>${esc(x.email)} · ${esc(x.mobile)} ${x.status==="pending"?`<button class="btn primary" data-approve="${d.id}">Approve</button> <button class="btn danger" data-reject="${d.id}">Reject</button>`:""}</div>`}).join("")||"No requests.";document.querySelectorAll("[data-approve]").forEach(b=>b.onclick=async()=>{try{await api("/api/approveDeposit",{depositId:b.dataset.approve});toast("Approved")}catch(x){toast(x.message)}});document.querySelectorAll("[data-reject]").forEach(b=>b.onclick=async()=>{try{await api("/api/rejectDeposit",{depositId:b.dataset.reject});toast("Rejected")}catch(x){toast(x.message)}})})}
function loadTournaments(){onSnapshot(query(collection(db,"tournaments"),orderBy("createdAt","desc")),s=>{$("adminTournaments").innerHTML=s.docs.map(d=>{const x=d.data();return `<div class="listrow"><b>${esc(x.name)}</b> · ${esc(x.mode)} · ₹${Number(x.entryFee||0)} · slots ${Number(x.joinedCount||0)}/${Number(x.totalSlots||0)}<br><small>${d.id}</small> <button class="btn danger" data-del="${d.id}">Delete</button></div>`}).join("")||"No tournaments.";document.querySelectorAll("[data-del]").forEach(b=>b.onclick=async()=>{if(!confirm("Delete this tournament?"))return;try{await api("/api/deleteTournament",{tournamentId:b.dataset.del});toast("Deleted")}catch(x){toast(x.message)}})})}
function loadPlayers(){onSnapshot(query(collection(db,"tournamentParticipants"),orderBy("joinedAt","desc")),s=>{$("players").innerHTML=s.docs.map(d=>{const x=d.data();return `<div class="listrow"><b>${esc(x.tournamentName)}</b><br>${esc(x.characterName)} · BGMI ${esc(x.bgmiId)} · WhatsApp ${esc(x.whatsapp)} · UPI ${esc(x.upiId)} · ₹${Number(x.entryFee||0)}</div>`}).join("")||"No players."})}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
