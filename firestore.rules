rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =====================================================
       ADMIN CHECK
    ===================================================== */

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    /* =====================================================
       USERS
    ===================================================== */

    match /users/{userId} {

      allow read: if signedIn();

      /*
       * Player can create only his/her own account.
       */
      allow create: if signedIn()
        && request.auth.uid == userId;

      /*
       * Admin can update anything.
       */
      allow update: if isAdmin();

      /*
       * Normal user can only change profile fields.
       * Wallet and role cannot be changed by player.
       */
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(
             resource.data
           ).affectedKeys().hasOnly([
             "name",
             "mobile",
             "age",
             "email"
           ]);

      allow delete: if isAdmin();
    }


    /* =====================================================
       TOURNAMENTS
    ===================================================== */

    match /tournaments/{tournamentId} {

      allow read: if true;

      allow create,
            update,
            delete: if isAdmin();
    }


    /* =====================================================
       TOURNAMENT PLAYERS
    ===================================================== */

    match /tournaments/{tournamentId}/players/{playerId} {

      allow read: if signedIn();

      allow create,
            update,
            delete: if isAdmin();
    }


    /* =====================================================
       TOURNAMENT PARTICIPANTS
    ===================================================== */

    match /tournamentParticipants/{participantId} {

      /*
       * Player can see only own participant record.
       * Admin can see everything.
       */
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid ==
             request.auth.uid
        );

      /*
       * Player can create only a participant
       * belonging to himself.
       */
      allow create: if signedIn()
        && request.resource.data.uid ==
           request.auth.uid
        && request.resource.data.status ==
           "joined"
        && request.resource.data.entryFee == 0;

      /*
       * Player cannot modify/delete participant.
       */
      allow update,
            delete: if isAdmin();
    }


    /* =====================================================
       ROOM CREDENTIALS
    ===================================================== */

    match /roomCredentials/{tournamentId} {

      allow read: if signedIn();

      allow create,
            update,
            delete: if isAdmin();
    }


    /* =====================================================
       OLD DEPOSITS COLLECTION
    ===================================================== */

    match /deposits/{depositId} {

      allow read,
            update,
            delete: if isAdmin();

      allow create: if signedIn();
    }


    /* =====================================================
       DEPOSIT REQUESTS
    ===================================================== */

    match /depositRequests/{depositId} {

      /*
       * PLAYER CREATE
       *
       * Player can create only his own
       * pending deposit request.
       */
      allow create: if signedIn()
        && request.resource.data.uid ==
           request.auth.uid

        && request.resource.data.status ==
           "pending"

        && request.resource.data.amount is number
        && request.resource.data.amount >= 1
        && request.resource.data.amount <= 50000

        && request.resource.data.utr is string
        && request.resource.data.utr.size() >= 4
        && request.resource.data.utr.size() <= 100

        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() >= 5
        && request.resource.data.mobile.size() <= 20

        && request.resource.data.email is string;

      /*
       * PLAYER CAN READ OWN REQUESTS.
       */
      allow read: if signedIn()
        && resource.data.uid ==
           request.auth.uid;

      /*
       * ADMIN CAN READ / UPDATE / DELETE.
       */
      allow read,
            update,
            delete: if isAdmin();
    }


    /* =====================================================
       WALLET TRANSACTIONS
    ===================================================== */

    match /walletTransactions/{transactionId} {

      /*
       * Player can read only own transactions.
       */
      allow read: if signedIn()
        && resource.data.uid ==
           request.auth.uid;

      /*
       * Admin can read everything.
       */
      allow read: if isAdmin();

      /*
       * Only admin can create wallet records.
       */
      allow create: if isAdmin();

      allow update,
            delete: if isAdmin();
    }


    /* =====================================================
       ADMIN SETTINGS
    ===================================================== */

    match /adminSettings/{settingId} {

      /*
       * Public settings contain logo,
       * splash and QR URL.
       */
      allow read: if true;

      allow create,
            update,
            delete: if isAdmin();
    }


    /* =====================================================
       GENERAL SETTINGS
    ===================================================== */

    match /settings/{settingId} {

      allow read: if true;

      allow create,
            update,
            delete: if isAdmin();
    }


    /* =====================================================
       SUPPORT
    ===================================================== */

    match /supportMessages/{messageId} {

      allow create: if signedIn()
        && request.resource.data.uid ==
           request.auth.uid;

      allow read: if signedIn()
        && resource.data.uid ==
           request.auth.uid;

      allow read,
            update,
            delete: if isAdmin();
    }


    /* =====================================================
       DEFAULT DENY
    ===================================================== */

    match /{document=**} {

      allow read,
            write: if false;
    }
  }
}
