rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    match /users/{userId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow update: if isAdmin();

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "name",
            "mobile",
            "age",
            "email"
          ]);
    }


    match /tournaments/{tournamentId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }


    match /tournaments/{tournamentId}/players/{playerId} {

      allow read: if request.auth != null;

      allow create, update, delete: if isAdmin();
    }


    match /tournamentParticipants/{participantId} {

      allow read: if (
        request.auth != null
        && resource.data.uid == request.auth.uid
      ) || isAdmin();

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    match /roomCredentials/{tournamentId} {

      allow read: if request.auth != null;

      allow create, update, delete: if isAdmin();
    }


    match /deposits/{depositId} {

      allow read, update, delete: if isAdmin();

      allow create: if request.auth != null;
    }


    // ===============================
    // DEPOSIT REQUESTS
    // ===============================

    match /depositRequests/{depositId} {

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid

        && request.resource.data.status == "pending"

        && request.resource.data.amount is number
        && request.resource.data.amount >= 1
        && request.resource.data.amount <= 50000

        && request.resource.data.utr is string
        && request.resource.data.utr.size() >= 4
        && request.resource.data.utr.size() <= 100

        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() >= 5
        && request.resource.data.mobile.size() <= 20

        && request.resource.data.email is string;


      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;


      allow read, update, delete: if isAdmin();
    }


    match /walletTransactions/{transactionId} {

      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow read: if isAdmin();

      allow create: if isAdmin();

      allow update, delete: if isAdmin();
    }


    match /adminSettings/{settingId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }


    match /settings/{settingId} {

      allow read: if true;

      allow write: if isAdmin();
    }


    match /supportMessages/{messageId} {

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow read, update, delete: if isAdmin();
    }


    match /{document=**} {

      allow read, write: if false;
    }

  }
}
